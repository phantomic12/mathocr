# =============================================================================
# MathOCR — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# ── Active LLM Provider ──────────────────────────────────────────────────────
# Options: fastflowlm | ollama | vllm | openai | anthropic | lmstudio | jan | localai | modal
MATHOCR_PROVIDER=fastflowlm

# ── FastFlowLM (local NPU) ───────────────────────────────────────────────────
# Default: http://localhost:52625
FASTFLOWLM_BASE_URL=http://localhost:52625
FASTFLOWLM_MODEL=qwen3.5:9b

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── vLLM ────────────────────────────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ── OpenAI (compatible) ──────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── LM Studio ───────────────────────────────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=lmstudio-community/...

# ── Jan ──────────────────────────────────────────────────────────────────────
JAN_BASE_URL=http://localhost:1337/v1
JAN_MODEL=...

# ── LocalAI ─────────────────────────────────────────────────────────────────
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_MODEL=...

# ── Modal (serverless) ─────────────────────────────────────────────────────
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...
MODAL_APP_NAME=mathocr

# ── Backend Settings ────────────────────────────────────────────────────────
# Temp directory for uploaded files (inside container)
MATHOCR_TEMP_DIR=/tmp/mathocr_uploads
# Max upload size in MB
MATHOCR_MAX_FILE_MB=50
# Allowed origins (comma-separated)
MATHOCR_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# SQLite database path
MATHOCR_DB_PATH=mathocr.db
