# ── Stage 1: Backend ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS backend

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
RUN python -c "import backend.main"  # smoke-check imports

EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ── Stage 2: Frontend build ─────────────────────────────────────────────────
FROM node:22-alpine AS frontend-build

WORKDIR /app
COPY frontend/package.json frontend/vite.config.js ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# ── Stage 3: Runtime ───────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    nginx \
    && rm -rf /var/lib/apt/lists/*

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend
COPY --from=backend /app/backend/ ./backend/

# Remove default site that overrides our config
RUN rm -f /etc/nginx/sites-enabled/default

# Copy frontend build
COPY --from=frontend-build /app/dist/ /usr/share/nginx/html/
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose
EXPOSE 8000 80

CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port 8000 & nginx -g 'daemon off;'"]
